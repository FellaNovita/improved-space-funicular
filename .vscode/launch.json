{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Attach to Integrated Browser",
      "request": "attach",
      "type": "editor-browser",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Run application",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run-script",
        "start"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}